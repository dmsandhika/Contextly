# PostgreSQL Database URL with pgvector support
DATABASE_URL="postgresql://username:password@localhost:5432/contextly_db?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"
AUTH_SECRET="your_auth_secret_here"

# Google Gemini API Key (for LLM RAG Chat & Text Embeddings)
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"
